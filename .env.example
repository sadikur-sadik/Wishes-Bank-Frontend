# ==============================================================================
# Wishes Bank LTD - Frontend Environment Variables (.env.example)
# Copy this file to .env.local and update with your local configuration.
# ==============================================================================

# NextAuth / Auth.js Secret Key
# Generate a secure 32+ character key using: openssl rand -base64 32
AUTH_SECRET=your-secure-random-32-byte-secret-here
NEXTAUTH_SECRET=your-secure-random-32-byte-secret-here

# NextAuth Canonical URL
NEXTAUTH_URL=http://localhost:3000

# Backend Express API Gateway Proxy Target
BACKEND_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# MongoDB Connection String (For NextAuth / Auth.js adapter)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wishes_bank_ltd?retryWrites=true&w=majority
